{
  "@context": {
    "topo": "https://purl.org/geojson/topo#",
    "points": {
      "@id": "topo:points",
      "@container": "@list"
    },
    "edges": {
      "@id": "topo:edges",
      "@container": "@list"
    },
    "solids": {
      "@id": "topo:solids",
      "@container": "@list"
    }
  }
}
