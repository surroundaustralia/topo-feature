{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A SolidAggregate feature: a single combined volumetric object formed by referencing a set of member Solid features by id, without describing any new boundary geometry of its own. geometry must be null.",
  "$defs": {
    "testCollection": {
      "$anchor": "testCollection",
      "description": "A convenience ref to a complete, testable collection objects and references",
      "$ref": "bblocks://ogc.geo.topo.features.topo-feature-collection"
    }
  },
  "allOf": [
    {
      "$ref": "bblocks://ogc.geo.topo.features.topo-feature"
    },
    {
      "properties": {
        "geometry": {
          "type": "null"
        },
        "topology": {
          "properties": {
            "type": {
              "type": "string",
              "const": "SolidAggregate"
            },
            "references": {
              "type": "array",
              "description": "Ids of the member Solid features aggregated into this combined volume.",
              "items": {
                "$ref": "bblocks://ogc.ogc-utils.iri-or-curie"
              },
              "minItems": 1
            }
          },
          "required": [
            "type",
            "references"
          ],
          "not": {
            "required": [
              "directed_references"
            ]
          }
        }
      },
      "required": [
        "topology"
      ]
    }
  ]
}
